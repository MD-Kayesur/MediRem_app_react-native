{
  "name": "medirem-monorepo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node api.js && turbo run dev",
    "build": "node api.js && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start": "node api.js && npm run mobile",
    "mobile": "npm --workspace=@medirem/mobile run start",
    "mobile:android": "npm --workspace=@medirem/mobile run android",
    "mobile:ios": "npm --workspace=@medirem/mobile run ios",
    "mobile:web": "npm --workspace=@medirem/mobile run web",
    "mobile:lint": "npm --workspace=@medirem/mobile run lint",
    "backend": "npm --workspace=@medirem/backend run start:dev",
    "backend:dev": "npm --workspace=@medirem/backend run start:dev",
    "backend:build": "npm --workspace=@medirem/backend run build",
    "backend:start": "npm --workspace=@medirem/backend run start",
    "prisma:generate": "npm --workspace=@medirem/backend run prisma:generate",
    "prisma:migrate": "npm --workspace=@medirem/backend run prisma:migrate",
    "prisma:studio": "npm --workspace=@medirem/backend run prisma:studio"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "turbo": "^2.4.4"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@react-native-async-storage/async-storage": "2.2.0"
  }
}
