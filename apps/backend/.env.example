# Environment variables template for MediRem NestJS + Prisma Backend
PORT=3000
DATABASE_URL="postgresql://neondb_owner:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@host/neondb?sslmode=require"
NEON_BRANCH=production
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Gmail SMTP Configuration for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediRem Health" <noreply@medirem.app>

# Real AI Agent / Chatbot Configuration
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://api.openai.com/v1

# JWT Authentication & Expiration Configuration (Handled from .env)
# Token lifetimes can be set using zeit/ms format (e.g. "15m", "1h", "24h", "7d", "30d") or seconds (e.g. 3600)
JWT_ACCESS_SECRET=medirem_jwt_access_super_secret_key_2026_production
JWT_REFRESH_SECRET=medirem_jwt_refresh_super_secret_key_2026_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

